# Supabase — projeto dedicado ao LoveHome (base propria, ver PRD 7.3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Redis (Upstash) — debounce, dedup, fila do widget
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Criptografia — AES-256-GCM (credenciais de canal, CPF) + base do HMAC de cpf_hash
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Cron (follow-up)
CRON_SECRET=

# Z-API — fallback; preferir cadastrar em /canais (criptografado em channel_configs)
ZAPI_INSTANCE=
ZAPI_TOKEN=
# Segredo do webhook: o Z-API não assina o callback, então a URL registrada lá
# leva `?token=<este valor>`. Sem ele o webhook recusa tudo (fail-closed).
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ZAPI_WEBHOOK_SECRET=
ZAPI_CLIENT_TOKEN=

# Meta Cloud API — fallback; preferir /canais
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Asaas — Marco 3. Schema ja existe desde o Marco 1, chamada real entra depois (PRD 14.4)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Numero do WhatsApp do atendimento, so digitos com DDI (ex: 5511999999999).
# Usado no botao "Falar sobre este imovel" da vitrine publica. Sem ele o link
# abre o WhatsApp sem destinatario.
NEXT_PUBLIC_WHATSAPP_NUMERO=
